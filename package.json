{
  "name": "craft-table",
  "version": "0.1.0",
  "description": "A design workbench for your product team: real React screens from your own design system, specs, versions, options, and Claude as a design partner.",
  "keywords": [
    "design",
    "design-system",
    "workbench",
    "prototyping",
    "react",
    "vite",
    "tailwindcss",
    "specs",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giangm9/craft-table.git"
  },
  "homepage": "https://github.com/giangm9/craft-table#readme",
  "bugs": {
    "url": "https://github.com/giangm9/craft-table/issues"
  },
  "type": "module",
  "bin": {
    "craft-table": "bin/craft-table.mjs"
  },
  "files": [
    "bin",
    "studio",
    "!studio/**/*.test.mjs",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test 'studio/lib/*.test.mjs' 'tests/*.test.mjs'",
    "test:e2e": "node tests/run-e2e.mjs",
    "typecheck": "tsc --noEmit -p studio/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@hocuspocus/provider": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "codemirror": "^6.0.2",
    "diff": "^8.0.4",
    "fast-diff": "^1.3.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.469.0",
    "marked": "^14.1.4",
    "mermaid": "^12.2.0",
    "postcss": "^8.4.0",
    "puppeteer": "25.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "ws": "^8.22.0",
    "y-codemirror.next": "^0.3.6",
    "yjs": "^13.6.33",
    "zod": "^4.6.6"
  }
}
